# --- Autenticação -----------------------------------------------------------
# Padrão: deixe a chave vazia/comentada e os agentes usam a sua ASSINATURA,
# com o login já feito no Claude CLI (`claude login`). Nada mais a configurar.
#
# Alternativa: descomente e defina uma chave para usar a API da Anthropic
# diretamente (cobrança por token). A chave nunca é gravada em logs nem no banco.
# ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor (HTTP + WebSocket), sempre em 127.0.0.1
PORT=4777

# Limite de gasto estimado em USD (opcional; vazio = sem limite).
# Ao atingir o limite, todas as execuções são pausadas.
# Com assinatura, o valor é uma estimativa de consumo, não uma cobrança.
BUDGET_USD=15

# Prazo (ms) para um agente responder a pergunta/pedido de outro antes de o
# pedido ser escalado para você (padrão: 300000 = 5 min).
# BUS_TIMEOUT_MS=300000
